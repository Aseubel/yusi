  "midTermMemories": [
    {"id": "7100011", "person": "lin", "text": "林晚秋对猫毛严重过敏，小时候被流浪猫抓伤过一次，从那以后一直很害怕猫靠近自己。"},
    {"id": "7100012", "person": "lin", "text": "林晚秋养了一只叫豆沙的草龟已经五年了，她说看乌龟慢吞吞爬的样子能让自己安静下来。"},
    {"id": "7100013", "person": "lin", "text": "林晚秋是自由插画师，最怕编辑临时改需求催稿，她习惯深夜画画但正在努力调整作息。"},
    {"id": "7100014", "person": "lin", "text": "林晚秋的外婆住在江南老宅，每年夏天都会寄来亲手晒制的茉莉花茶。"},
    {"id": "7100015", "person": "lin", "text": "林晚秋在拥挤的电梯里会紧张到腿软，所以平时更喜欢走楼梯。"},
    {"id": "7100016", "person": "lin", "text": "林晚秋每周三晚上会在社区画室教小朋友画素描。"},
    {"id": "7100017", "person": "lin", "text": "林晚秋最近在尝试用钢笔淡彩画新系列的街景创作。"},
    {"id": "7100018", "person": "lin", "text": "林晚秋报了个烘焙班，想学做茉莉花茶口味的马卡龙当伴手礼。"},

    {"id": "7100021", "person": "chen", "text": "陈北野坚持晨跑七年，半程马拉松最好成绩是一小时三十八分。"},
    {"id": "7100022", "person": "chen", "text": "陈北野的弟弟在外地读研究生，兄弟俩每个月固定约一次联机打游戏。"},
    {"id": "7100023", "person": "chen", "text": "陈北野有轻微腰椎间盘突出，久坐后会去公司楼下的理疗店推拿缓解。"},
    {"id": "7100024", "person": "chen", "text": "陈北野在自学吉他，想赶在父亲六十大寿前学会弹唱《月亮代表我的心》。"},
    {"id": "7100025", "person": "chen", "text": "陈北野对咖啡因敏感，下午两点之后一滴咖啡都不敢喝，否则整夜睡不着。"},
    {"id": "7100026", "person": "chen", "text": "陈北野报名了明年春天的全程马拉松训练营，已经开始积累月跑量。"},
    {"id": "7100027", "person": "chen", "text": "陈北野收藏机械键盘，偏爱声音清脆的青轴手感。"},
    {"id": "7100028", "person": "chen", "text": "陈北野刚给吉他买了变调夹，方便按原调练习弹唱。"},

    {"id": "7100031", "person": "su", "text": "苏晚宁擅长烘焙，她做的芋泥戚风蛋糕曾在科室聚会上被同事抢空。"},
    {"id": "7100032", "person": "su", "text": "苏晚宁是急诊科护士，下夜班后要靠白噪音播客才能慢慢入睡。"},
    {"id": "7100033", "person": "su", "text": "苏晚宁春天会对花粉过敏，出门必须戴好口罩。"},
    {"id": "7100034", "person": "su", "text": "苏晚宁和妈妈约定每个周日晚上视频电话，雷打不动。"},
    {"id": "7100035", "person": "su", "text": "苏晚宁家里养了两只布偶猫，分别叫团子和雪球，性格一只粘人一只高冷。"},
    {"id": "7100036", "person": "su", "text": "苏晚宁正在备考注册营养师证书，每天通勤路上听课。"},
    {"id": "7100037", "person": "su", "text": "苏晚宁家中的烤箱用了六年刚坏，她正攒钱换一台风炉烤箱。"},
    {"id": "7100038", "person": "su", "text": "苏晚宁在食谱收藏夹里存了一百多道想试做的甜品清单。"},

    {"id": "7100041", "person": "zhou", "text": "周砚舟是高中化学老师，今年带高三毕业班，他觉得升学季压力大但很有成就感。"},
    {"id": "7100042", "person": "zhou", "text": "周砚舟每天骑自行车二十公里上下班，风雨无阻。"},
    {"id": "7100043", "person": "zhou", "text": "周砚舟会在课堂上和学生玩化学谜语接龙，把抽象概念编成顺口溜帮助记忆。"},
    {"id": "7100044", "person": "zhou", "text": "周砚舟和妻子结婚十周年，两人商量好把今年的结婚纪念日预算拿来换一台相机。"},
    {"id": "7100045", "person": "zhou", "text": "周砚舟胃不太好，医生叮嘱他少吃辣，他已经戒了火锅半年。"},
    {"id": "7100046", "person": "zhou", "text": "周砚舟大学时拿过省化学竞赛一等奖，这是他当年选择教书的原因之一。"},
    {"id": "7100047", "person": "zhou", "text": "周砚舟周末常去郊外爬山，顺便练习风光摄影。"},
    {"id": "7100048", "person": "zhou", "text": "周砚舟换了台微单相机，最想拍的是花草露水的微距题材。"},

    {"id": "7100051", "person": "gu", "text": "顾星辞是大三学生，正在备战十一月的青年小提琴独奏比赛，每天保底四小时练琴。"},
    {"id": "7100052", "person": "gu", "text": "顾星辞上周左手手指拉伤，遵医嘱冰敷并暂停高强度练习两周。"},
    {"id": "7100053", "person": "gu", "text": "顾星辞在琴行兼职打工，想攒钱换一把更好的碳纤维琴弓。"},
    {"id": "7100054", "person": "gu", "text": "顾星辞在学校弦乐社团负责招新海报的设计排版。"},
    {"id": "7100055", "person": "gu", "text": "顾星辞从小学五年级开始学小提琴，至今正好满十年琴龄。"},
    {"id": "7100056", "person": "gu", "text": "顾星辞最喜欢的曲目是《梁祝》，梦想有一天能完整登台演奏。"},
    {"id": "7100057", "person": "gu", "text": "顾星辞因为在宿舍台灯下深夜练琴被室友投诉，后来都去琴房练习。"},
    {"id": "7100058", "person": "gu", "text": "顾星辞报名了寒假举办的冬季音乐集训营，导师是他仰慕已久的一位演奏家。"}
  ],
  "diaries": [
    {"diaryId": "d-lin-01", "person": "lin", "entryDate": "2026-03-02", "header": "2026-03-02 星期一 晴", "body": "今天把端午龙舟主题的插画风稿交给了编辑，她说水面的分镜比上一版亮很多，终于可以把这个项目翻篇了。中午奖励了自己一碗双皮奶。"},
    {"diaryId": "d-lin-02", "person": "lin", "entryDate": "2026-03-15", "header": "2026-03-15 星期日 多云", "body": "路口的井盖上蹲着一只橘猫，离我有三四步远。心跳快得不行，我贴着马路对面绕了一个大圈才敢继续走。回家画了两笔也没缓过来。"},
    {"diaryId": "d-lin-03", "person": "lin", "entryDate": "2026-04-06", "header": "2026-04-06 星期一 小雨", "body": "给外婆寄的新护膝今天显示签收了，我又在包裹里塞了一张手绘卡片。有点想念老宅院子里晒着茉莉花茶的竹匾。"},
    {"diaryId": "d-chen-01", "person": "chen", "entryDate": "2026-02-21", "header": "2026-02-21 星期六 风", "body": "凌晨五点半的江边只有路灯和我。今天的长距离拉练完成了三十公里，后半程平均配速掉得不厉害，膝盖感觉还行。回来补了个两小时的觉。"},
    {"diaryId": "d-chen-02", "person": "chen", "entryDate": "2026-03-29", "header": "2026-03-29 星期日 晴", "body": "把吉他的琴弦换成尼龙的了，按和弦的时候指尖没那么疼，F 和弦终于不再像刑具。《月亮代表我的心》副歌部分勉强能连下来。"},
    {"diaryId": "d-chen-03", "person": "chen", "entryDate": "2026-04-19", "header": "2026-04-19 星期日 阴", "body": "训练营第一节合练，认识了新的兔子配速员，他说我的步频接近职业选手的水平。月跑量计划重新排进了日程表。"},
    {"diaryId": "d-su-01", "person": "su", "entryDate": "2026-03-08", "header": "2026-03-08 星期日 晴", "body": "下了大夜班没有立刻睡觉，鬼使神差开烤了第一炉蛋挞。火候过了心整个焦掉，第二炉盯着烤箱门守到最后一分钟才算成功。困但快乐。"},
    {"diaryId": "d-su-02", "person": "su", "entryDate": "2026-04-12", "header": "2026-04-12 星期日 晴", "body": "和妈妈的周日视频如期进行，远程教她把家里的路由器密码改成了强密码。挂电话之前她又叮嘱我少喝冰的，明明是她昨天还在吃冰西瓜。"},
    {"diaryId": "d-zhou-01", "person": "zhou", "entryDate": "2026-03-20", "header": "2026-03-20 星期五 阴", "body": "高三实验室轮到酸碱滴定那一组。有个平时不爱举手的孩子设计了两种指示剂交叉验证的方案，全组的老师看完都说这届学生不得了。"},
    {"diaryId": "d-zhou-02", "person": "zhou", "entryDate": "2026-04-11", "header": "2026-04-11 星期六 晴转霞", "body": "骑行到渡口正赶上日出，江面一下子被染红，停车拍了十几张。回家挑了一张构图最好的发给妻子，她说可以做结婚纪念日的贺卡封面。"},
    {"diaryId": "d-gu-01", "person": "gu", "entryDate": "2026-03-13", "header": "2026-03-13 星期五 夜", "body": "在琴房加练到十点，运弓终于从前三小节的发抖变成了连贯的长线条。手指上的茧越来越厚， 比赛 七个月后的那个舞台好像也不那么远了。"},
    {"diaryId": "d-gu-02", "person": "gu", "entryDate": "2026-04-05", "header": "2026-04-05 星期日 雨", "body": "老师下午讲了《梁祝》背后的民间故事和作曲年代，讲到化蝶那一段时我停了很久。回宿舍的路上耳朵里全是那段协奏的旋律。"}
