# Copy this file to yusi_prod.env on the production host and replace every
# placeholder. Keep yusi_prod.env outside Git and restrict it to mode 600.

# Java runtime
SPRING_PROFILES_ACTIVE=prod
MCP_ENABLED=true

# Database
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-with-database-password
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/yusi?serverTimezone=UTC&characterEncoding=utf8&autoReconnect=true&serverTimezone=Asia/Shanghai

# Redis
REDIS_SDK_CONFIG_HOST=redis
REDIS_SDK_CONFIG_PORT=6379
REDIS_SDK_CONFIG_PASSWORD=

# JWT and diary encryption
YUSI_JWT_SECRET=replace-with-a-long-random-jwt-secret
YUSI_ENCRYPTION_KEY=replace-with-base64-encoded-aes-key
YUSI_BACKUP_RSA_PUBLIC_KEY_SPKI_BASE64=replace-with-base64-rsa-public-key
YUSI_BACKUP_RSA_PRIVATE_KEY_PKCS8_BASE64=replace-with-base64-rsa-private-key

# Web and proxy boundaries
YUSI_WEB_ALLOWED_ORIGIN=https://app.aseubel.cn
YUSI_TRUSTED_PROXY_ADDRESSES=

# Object storage
OSS_DOMAIN=oss.aseubel.cn
OSS_REGION=cn-guangzhou
OSS_BUCKET_NAME=replace-with-oss-bucket
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-with-oss-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-oss-access-key-secret

# AI models
EMBEDDING_MODEL_BASEURL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL_APIKEY=replace-with-embedding-api-key
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_DIMENSION=1024
QWEN_BASEURL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_APIKEY=replace-with-qwen-api-key
QWEN_MODEL=qwen3.5-flash-2026-02-23
DEEPSEEK_BASEURL=https://api.deepseek.com
DEEPSEEK_APIKEY=replace-with-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional speech-to-text providers
ASR_ENABLED=false
ASR_BASE_URL=https://api.openai.com/v1/audio/transcriptions
ASR_API_KEY=
ASR_MODEL=whisper-1
DASHSCOPE_ASR_ENABLED=false
DASHSCOPE_ASR_BASEURL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2

# Milvus / Zilliz
MILVUS_URI=replace-with-milvus-uri
MILVUS_TOKEN=replace-with-milvus-token
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_USERNAME=
MILVUS_PASSWORD=

# Third-party APIs
AMAP_KEY=replace-with-amap-key
ALIYUN_DM_ACCESS_KEY_ID=replace-with-aliyun-mail-access-key-id
ALIYUN_DM_ACCESS_KEY_SECRET=replace-with-aliyun-mail-access-key-secret
ALIYUN_DM_ACCOUNT_NAME=yusi@mail.aseubel.cn

# Shared secret between Java and the internal MCP route.
# The MCP compose file maps this value to SERVER_AUTH_API_KEY.
MCP_AUTH_API_KEY=replace-with-a-long-random-mcp-service-key

# MCP gateway settings. The public gateway receives only these selected values.
GRPC_BACKEND_TARGET=yusi:9090
SEARCH_PROVIDER=bocha
SEARCH_API_KEY=replace-with-search-api-key
# Required only when SEARCH_PROVIDER=google.
SEARCH_CX=
